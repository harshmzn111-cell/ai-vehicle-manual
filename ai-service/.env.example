# Google Gemini API key — used for BOTH embeddings (gemini-embedding-001)
# and all LLM calls (extraction, grading, manual-candidate validation,
# diagnosis generation) via gemini-2.5-flash. Tavily is used purely as the
# web-search tool; Gemini is what reads/synthesizes whatever Tavily returns.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily web search API key — used for on-demand manual discovery,
# the problem/DTC web-search fallback, and relevant-image lookup.
# Optional: if omitted, manual discovery and web fallback are skipped
# (diagnosis still runs on whatever's already indexed in ChromaDB).
TAVILY_API_KEY=your_tavily_api_key_here

# ChromaDB
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=vehicle_manuals

# LLM / embedding / retrieval tuning.
# Google retires Gemini models on a schedule — check
# https://ai.google.dev/gemini-api/docs/deprecations if either of these
# starts 404ing again, and see that page's "Recommended replacement" column.
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RETRIEVAL_TOP_K=6

# Knowledge Sufficiency Evaluator (retrieval_service.py) — cosine-distance
# ceiling (0=identical, 2=opposite) for a local chunk to be considered
# confidently relevant. Lower = stricter (more likely to fall back to web
# search); higher = more lenient (trusts local chunks more often).
SIMILARITY_DISTANCE_THRESHOLD=0.45

# User manual uploads (POST /api/v1/upload-manual)
# User manual uploads (POST /api/v1/upload-manual)
MANUALS_STORAGE_PATH=./data/uploads/manuals
MANUALS_REGISTRY_PATH=./data/manuals_registry.json
MAX_UPLOAD_BYTES=62914560

# Scenario C default: vehicles with no manual in ChromaDB skip straight to
# Tavily web search rather than crashing or trying to auto-find/ingest a
# whole official manual PDF. Set true to opt back into that older, slower
# auto-discovery behavior (manual_discovery.py) on first query for a vehicle.
ENABLE_AUTO_MANUAL_DISCOVERY=false

# CORS: comma-separated list of allowed origins (use * for local dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

PORT=8000
